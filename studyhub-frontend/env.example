# ─── StudyHub Frontend — Environment Variables ───────────────────────────────
# Copy file này thành .env rồi điền giá trị thực:
#   cp env.example .env
#
# Lưu ý: biến PHẢI có tiền tố VITE_ thì Vite mới inject vào bundle.
# Không commit file .env vào git (đã có trong .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Dev local (có proxy trong vite.config.js) ─────────────────────────────────
# Dùng /api (relative) để Vite proxy sang :8080 → không bị CORS
VITE_API_BASE_URL=/api

# Hoặc dùng URL tuyệt đối nếu không muốn proxy (cần bật CORS phía Spring Boot):
# VITE_API_BASE_URL=http://localhost:8080/api

# ── Production ────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=https://api.studyhub.vn/api

# ── WebSocket (dùng ws:// cho local, wss:// cho production HTTPS) ─────────────
# Chỉ cần đặt nếu WS server khác host với API.
# Mặc định chatApi.js tự tính từ VITE_API_BASE_URL.
# VITE_WS_BASE_URL=ws://localhost:8080
