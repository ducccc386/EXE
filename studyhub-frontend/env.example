# ─── StudyHub Frontend — Environment Variables ───────────────────────────────
# Copy file này thành .env rồi điền giá trị thực:
#   cp .env.example .env
#
# Lưu ý: mọi biến PHẢI có tiền tố VITE_ thì Vite mới inject vào bundle.
# Không commit file .env vào git (đã có trong .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# URL gốc của Spring Boot backend (không có dấu / ở cuối)
# Dev local:
VITE_API_BASE_URL=http://localhost:8080/api

# WebSocket endpoint (dùng ws:// cho local, wss:// cho production HTTPS)
# Được dùng trong chatApi.js để kết nối ws://localhost:8080/ws/chat
VITE_WS_BASE_URL=ws://localhost:8080
